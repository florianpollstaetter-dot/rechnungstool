+    /**
+     * Creates a new EBICS subscriber whose A005 / X002 / E002 key material is
+     * supplied externally — typically by a SunPKCS11 HSM or smartcard binding.
+     * The library does <b>not</b> generate fresh key pairs and does <b>not</b>
+     * persist private keys to disk. INI/HIA letters are still written to
+     * {@code configuration.getLettersDirectory(user)} because they carry only
+     * the public-key hashes.
+     *
+     * <p>This is the supported entry point for HSM-backed Treasury / commercial
+     * subscribers. The original
+     * {@link #createUser(URL, String, String, String, String, String, String,
+     * String, String, boolean, boolean,
+     * org.kopi.ebics.interfaces.PasswordCallback) createUser} overload remains
+     * untouched and continues to generate and persist a PKCS#12 keystore.
+     *
+     * @param url the bank URL
+     * @param bankName the bank name
+     * @param hostId the bank host ID
+     * @param partnerId the partner ID
+     * @param userId UserId as obtained from the bank
+     * @param name the user name
+     * @param email the user email
+     * @param country the user country
+     * @param organization the user organization or company
+     * @param useCertificates does the bank use certificates?
+     * @param passwordCallback callback handler for the password (may be
+     *        {@code null} for externally-keyed subscribers — see
+     *        {@link User#User(org.kopi.ebics.interfaces.EbicsPartner, String,
+     *        String, String, String, String,
+     *        org.kopi.ebics.interfaces.PasswordCallback, ExternalKeyProvider)})
+     * @param externalKeys supplier of the A005 / X002 / E002 key triples
+     * @return the new subscriber
+     * @throws IllegalArgumentException if {@code externalKeys} is null or
+     *         returns null material for any of the three roles
+     * @throws Exception on any persistence or letter-write failure
+     */
+    public User createUser(URL url, String bankName, String hostId, String partnerId,
+        String userId, String name, String email, String country, String organization,
+        boolean useCertificates, PasswordCallback passwordCallback,
+        ExternalKeyProvider externalKeys) throws Exception {
+        log.info(messages.getString("user.create.info", userId));
+        if (externalKeys == null) {
+            throw new IllegalArgumentException("externalKeys is required");
+        }
+
+        Bank bank = createBank(url, bankName, hostId, useCertificates);
+        Partner partner = createPartner(bank, partnerId);
+        try {
+            User user = new User(partner, userId, name, email, country, organization,
+                passwordCallback, externalKeys);
+            createUserDirectories(user);
+            // saveUserCertificates() is intentionally NOT called: external keys
+            // are HSM/smartcard-resident and the library MUST NOT mirror them to
+            // disk. The legacy PKCS#12 path remains via the original createUser.
+            configuration.getSerializationManager().serialize(bank);
+            configuration.getSerializationManager().serialize(partner);
+            configuration.getSerializationManager().serialize(user);
+            createLetters(user, useCertificates);
+            users.put(userId, user);
+            partners.put(partner.getPartnerId(), partner);
+            banks.put(bank.getHostId(), bank);
+
+            log.info(messages.getString("user.create.success", userId));
+            return user;
+        } catch (Exception e) {
+            log.error(messages.getString("user.create.error"), e);
+            throw e;
+        }
+    }
+
     private void createLetters(EbicsUser user, boolean useCertificates)
         throws GeneralSecurityException, IOException, EbicsException {
         user.getPartner().getBank().setUseCertificate(useCertificates);
diff --git a/src/main/java/org/kopi/ebics/client/ExternalKeyProvider.java b/src/main/java/org/kopi/ebics/client/ExternalKeyProvider.java
new file mode 100644
index 0000000..7798753
--- /dev/null
+++ b/src/main/java/org/kopi/ebics/client/ExternalKeyProvider.java
@@ -0,0 +1,71 @@
+/*
+ * Copyright (c) 2026 Orange Octo SARL.
+ *
+ * This file is added on top of the kopiLeft-licensed ebics-java-client (LGPL 2.1)
+ * and is licensed under the same terms.
+ */
+
+package org.kopi.ebics.client;
+
+import java.security.PrivateKey;
+import java.security.cert.X509Certificate;
+
+/**
+ * Supplies the A005 / X002 / E002 key material for a subscriber when the caller
+ * holds the private keys outside the JVM heap (HSM, smartcard, or any other
+ * provider-attached {@link PrivateKey} — typically {@code SunPKCS11}).
+ *
+ * <p>Use this interface together with
+ * {@link EbicsClient#createUser(java.net.URL, String, String, String, String,
+ * String, String, String, String, boolean,
+ * org.kopi.ebics.interfaces.PasswordCallback, ExternalKeyProvider)} to provision
+ * an EBICS subscriber whose A005/X002 signing operations execute inside the
+ * device — the library never sees plaintext key bytes.
+ *
+ * <p><b>Caller invariant.</b> When the keys are intended to be HSM-resident, the
+ * returned {@link PrivateKey} instances MUST be provider-attached (their class
+ * lives under the provider that issued them, e.g. {@code sun.security.pkcs11.*})
+ * AND their {@code getEncoded()} MUST return {@code null}. The library does not
+ * enforce this — callers are responsible for the on-token / off-token decision
+ * via PKCS#11 attributes (typically {@code CKA_SENSITIVE=true} and
+ * {@code CKA_EXTRACTABLE=false}).
+ */
+public interface ExternalKeyProvider {
+
+    /** Signature key (EBICS role A005). */
+    KeyMaterial a005();
+
+    /** Identification &amp; authentication key (EBICS role X002). */
+    KeyMaterial x002();
+
+    /** Encryption key (EBICS role E002). */
+    KeyMaterial e002();
+
+    /**
+     * One (PrivateKey, X509Certificate) pair for a single EBICS role.
+     * Both fields are required; {@code null} either parameter throws.
+     */
+    final class KeyMaterial {
+        private final PrivateKey privateKey;
+        private final X509Certificate certificate;
+
+        public KeyMaterial(PrivateKey privateKey, X509Certificate certificate) {
+            if (privateKey == null) {
+                throw new IllegalArgumentException("privateKey is required");
+            }
+            if (certificate == null) {
+                throw new IllegalArgumentException("certificate is required");
+            }
+            this.privateKey = privateKey;
+            this.certificate = certificate;
+        }
+
+        public PrivateKey getPrivateKey() {
+            return privateKey;
+        }
+
+        public X509Certificate getCertificate() {
+            return certificate;
+        }
+    }
+}
