+    ExternalKeyProvider.KeyMaterial a005 = externalKeys.a005();
+    ExternalKeyProvider.KeyMaterial x002 = externalKeys.x002();
+    ExternalKeyProvider.KeyMaterial e002 = externalKeys.e002();
+    if (a005 == null || x002 == null || e002 == null) {
+      throw new IllegalArgumentException(
+          "ExternalKeyProvider must return non-null material for A005, X002 and E002");
+    }
+    this.partner = partner;
+    this.userId = userId;
+    this.name = name;
+    this.dn = makeDN(name, email, country, organization);
+    this.passwordCallback = passwordCallback;
+    this.a005Certificate = a005.getCertificate();
+    this.a005PrivateKey = a005.getPrivateKey();
+    this.x002Certificate = x002.getCertificate();
+    this.x002PrivateKey = x002.getPrivateKey();
+    this.e002Certificate = e002.getCertificate();
+    this.e002PrivateKey = e002.getPrivateKey();
+    needSave = true;
+  }
+
   /**
    * Reconstructs a persisted EBICS user.
    *
@@ -159,7 +218,11 @@ public class User implements EbicsUser, Savable {
    */
   public void saveUserCertificates(File directory) throws GeneralSecurityException, IOException {
     if (manager == null) {
-      throw new GeneralSecurityException("Cannot save user certificates");
+      // Externally-provisioned keys (HSM / smartcard) are not the library's to
+      // persist — they live in the device that issued them. Silently no-op so
+      // callers can share the same createUser → saveUserCertificates flow for
+      // both internal-key and external-key subscribers.
+      return;
     }
 
     manager.save(directory, passwordCallback);
@@ -456,9 +519,7 @@ public class User implements EbicsUser, Savable {
    */
   @Override
   public byte[] authenticate(byte[] digest) throws GeneralSecurityException {
-    Signature			signature;
-
-    signature = Signature.getInstance("SHA256WithRSA", BouncyCastleProvider.PROVIDER_NAME);
+    Signature signature = newSignature("SHA256WithRSA", x002PrivateKey);
     signature.initSign(x002PrivateKey);
     signature.update(digest);
     return signature.sign();
@@ -511,12 +572,56 @@ public class User implements EbicsUser, Savable {
    */
   @Override
   public byte[] sign(byte[] digest) throws GeneralSecurityException {
-    Signature signature = Signature.getInstance("SHA256WithRSA", BouncyCastleProvider.PROVIDER_NAME);
+    Signature signature = newSignature("SHA256WithRSA", a005PrivateKey);
     signature.initSign(a005PrivateKey);
     signature.update(removeOSSpecificChars(digest));
     return signature.sign();
   }
 
+  /**
+   * Builds a {@link Signature} instance for the given {@code key}, routing the
+   * sign operation to the JCE provider that issued the key.
+   *
+   * <p>If the key is rooted in a named {@code SunPKCS11-*} provider (typical for
+   * HSM / smartcard subscribers) the Signature is bound to that provider so the
+   * private-key bytes never enter the JVM heap. Otherwise the historical
+   * {@link BouncyCastleProvider#PROVIDER_NAME BouncyCastle} provider is used,
+   * which preserves bit-for-bit identical behaviour for the legacy
+   * in-process PKCS#12 keystore flow.
+   */
+  private static Signature newSignature(String algorithm, PrivateKey key)
+    throws NoSuchAlgorithmException, NoSuchProviderException
+  {
+    Provider keyProvider = providerOf(key);
+    if (keyProvider != null) {
+      return Signature.getInstance(algorithm, keyProvider);
+    }
+    return Signature.getInstance(algorithm, BouncyCastleProvider.PROVIDER_NAME);
+  }
+
+  /**
+   * Resolves the JCE {@link Provider} that issued {@code key} when the key is
+   * provider-attached (e.g. SunPKCS11 HSM keys). Returns {@code null} for
+   * heap-resident software keys so callers fall through to the historical
+   * BouncyCastle path.
+   */
+  private static Provider providerOf(java.security.Key key) {
+    if (key == null) {
+      return null;
+    }
+    String className = key.getClass().getName();
+    // SunPKCS11 keys are rooted under sun.security.pkcs11.* — the matching
+    // provider is registered with a name of the form "SunPKCS11-<configName>".
+    if (className.startsWith("sun.security.pkcs11.")) {
+      for (Provider p : Security.getProviders()) {
+        if (p.getName().startsWith("SunPKCS11")) {
+          return p;
+        }
+      }
+    }
+    return null;
+  }
+
   /**
    * EBICS IG CFONB VF 2.1.4 2012 02 24 - 2.1.3.2 Calcul de la signature:
    *
@@ -538,7 +643,12 @@ public class User implements EbicsUser, Savable {
     int				blockSize;
     ByteArrayOutputStream	outputStream;
 
-    cipher = Cipher.getInstance("RSA/NONE/PKCS1Padding", BouncyCastleProvider.PROVIDER_NAME);
+    Provider e002Provider = providerOf(e002PrivateKey);
+    if (e002Provider != null) {
+      cipher = Cipher.getInstance("RSA/NONE/PKCS1Padding", e002Provider);
+    } else {
+      cipher = Cipher.getInstance("RSA/NONE/PKCS1Padding", BouncyCastleProvider.PROVIDER_NAME);
+    }
     cipher.init(Cipher.DECRYPT_MODE, e002PrivateKey);
     blockSize = cipher.getBlockSize();
     outputStream = new ByteArrayOutputStream();
diff --git a/src/test/java/org/kopi/ebics/client/ExternalKeyProviderTest.java b/src/test/java/org/kopi/ebics/client/ExternalKeyProviderTest.java
new file mode 100644
index 0000000..8a42d43
--- /dev/null
+++ b/src/test/java/org/kopi/ebics/client/ExternalKeyProviderTest.java
@@ -0,0 +1,171 @@
+/*
+ * Copyright (c) 2026 Orange Octo SARL.
+ *
+ * Tests for the ExternalKeyProvider SPI added to support HSM-backed
+ * subscribers (PKCS#11 / SunPKCS11). LGPL 2.1.
+ */
+
+package org.kopi.ebics.client;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+import java.math.BigInteger;
+import java.security.KeyPair;
+import java.security.KeyPairGenerator;
+import java.security.PrivateKey;
+import java.security.Security;
+import java.security.cert.X509Certificate;
+import java.time.Instant;
+import java.time.temporal.ChronoUnit;
+import java.util.Date;
+
+import org.bouncycastle.cert.X509v3CertificateBuilder;
+import org.bouncycastle.cert.jcajce.JcaX509CertificateConverter;
+import org.bouncycastle.cert.jcajce.JcaX509v3CertificateBuilder;
+import org.bouncycastle.jce.X509Principal;
+import org.bouncycastle.jce.provider.BouncyCastleProvider;
+import org.bouncycastle.operator.ContentSigner;
+import org.bouncycastle.operator.jcajce.JcaContentSignerBuilder;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Verifies the {@link ExternalKeyProvider} guard rails plus the
+ * {@link User} constructor that consumes external key material.
+ *
+ * <p>No HSM is required for this suite — synthetic in-process RSA keys play
+ * the role the SunPKCS11 provider would in production. The HSM-specific
+ * provider routing in {@link User#newSignature} is exercised separately in
+ * the sidecar's {@code SoftHsmA005SigningTest}.
+ */
+class ExternalKeyProviderTest {
+
+    @BeforeAll
+    static void registerBouncyCastle() {
+        if (Security.getProvider(BouncyCastleProvider.PROVIDER_NAME) == null) {
+            Security.addProvider(new BouncyCastleProvider());
+        }
+    }
+
+    @Test
+    void keyMaterial_rejects_null_privateKey() {
+        X509Certificate cert = newSelfSignedCert();
+        assertThrows(IllegalArgumentException.class,
+            () -> new ExternalKeyProvider.KeyMaterial(null, cert));
+    }
+
+    @Test
+    void keyMaterial_rejects_null_certificate() {
+        PrivateKey pk = newRsaKeyPair().getPrivate();
+        assertThrows(IllegalArgumentException.class,
+            () -> new ExternalKeyProvider.KeyMaterial(pk, null));
+    }
+
+    @Test
+    void user_constructor_assigns_all_three_roles() throws Exception {
+        ExternalKeyProvider provider = stubProvider();
+        Partner partner = new Partner(stubBank(), "PARTNER_TEST");
+        User user = new User(partner, "USER_TEST", "Test User",
+            "test@example.org", "DE", "Orange Octo", null, provider);
+
+        // The setters target the same fields as the legacy CertificateManager
+        // path, so the public-key getters should now return the keys we wired.
+        assertNotNull(user.getA005PublicKey(),
+            "A005 public key must be reachable after external-key install");
+        assertNotNull(user.getX002PublicKey());
+        assertNotNull(user.getE002PublicKey());
+        assertEquals("USER_TEST", user.getUserId());
+    }
+
+    @Test
+    void user_constructor_rejects_null_provider() {
+        Partner partner = new Partner(stubBank(), "PARTNER_TEST");
+        assertThrows(IllegalArgumentException.class,
+            () -> new User(partner, "USER_TEST", "Test User",
+                "test@example.org", "DE", "Orange Octo", null, null));
+    }
+
+    @Test
+    void user_sign_with_external_software_key_routes_through_bouncycastle()
+        throws Exception
+    {
+        // For software keys (no SunPKCS11 attachment), the patched User.newSignature
+        // falls through to BouncyCastle — proving zero regression on the legacy
+        // in-process flow.
+        ExternalKeyProvider provider = stubProvider();
+        Partner partner = new Partner(stubBank(), "PARTNER_TEST");
+        User user = new User(partner, "USER_TEST", "Test User",
+            "test@example.org", "DE", "Orange Octo", null, provider);
+
+        byte[] digest = "hello".getBytes();
+        byte[] sig = user.sign(digest);
+        assertNotNull(sig);
+        // 2048-bit RSA → 256-byte signature.
+        assertEquals(256, sig.length);
+    }
+
+    // ------------------------------------------------------------------
+    // helpers
+    // ------------------------------------------------------------------
+
+    private static Bank stubBank() {
+        try {
+            return new Bank(new java.net.URL("https://example.test/ebics"),
+                "TestBank", "TESTHOST", false);
+        } catch (Exception e) {
+            throw new RuntimeException(e);
+        }
+    }
+
+    private static ExternalKeyProvider stubProvider() {
+        KeyPair a005 = newRsaKeyPair();
+        KeyPair x002 = newRsaKeyPair();
+        KeyPair e002 = newRsaKeyPair();
+        X509Certificate a005Cert = newSelfSignedCertFor(a005);
+        X509Certificate x002Cert = newSelfSignedCertFor(x002);
+        X509Certificate e002Cert = newSelfSignedCertFor(e002);
+        return new ExternalKeyProvider() {
+            @Override public KeyMaterial a005() { return new KeyMaterial(a005.getPrivate(), a005Cert); }
+            @Override public KeyMaterial x002() { return new KeyMaterial(x002.getPrivate(), x002Cert); }
+            @Override public KeyMaterial e002() { return new KeyMaterial(e002.getPrivate(), e002Cert); }
+        };
+    }
+
+    private static KeyPair newRsaKeyPair() {
+        try {
+            KeyPairGenerator kpg = KeyPairGenerator.getInstance("RSA",
+                BouncyCastleProvider.PROVIDER_NAME);
+            kpg.initialize(2048);
+            return kpg.generateKeyPair();
+        } catch (Exception e) {
+            throw new RuntimeException(e);
+        }
+    }
+
+    private static X509Certificate newSelfSignedCert() {
+        return newSelfSignedCertFor(newRsaKeyPair());
+    }
+
+    private static X509Certificate newSelfSignedCertFor(KeyPair pair) {
+        try {
+            X509Principal subject = new X509Principal("CN=test, O=Orange Octo, C=DE");
+            X509v3CertificateBuilder builder = new JcaX509v3CertificateBuilder(
+                new javax.security.auth.x500.X500Principal(subject.getName()),
+                BigInteger.ONE,
+                Date.from(Instant.now()),
+                Date.from(Instant.now().plus(365, ChronoUnit.DAYS)),
+                new javax.security.auth.x500.X500Principal(subject.getName()),
+                pair.getPublic());
+            ContentSigner signer = new JcaContentSignerBuilder("SHA256WithRSA")
+                .setProvider(BouncyCastleProvider.PROVIDER_NAME)
+                .build(pair.getPrivate());
+            return new JcaX509CertificateConverter()
+                .setProvider(BouncyCastleProvider.PROVIDER_NAME)
+                .getCertificate(builder.build(signer));
+        } catch (Exception e) {
+            throw new RuntimeException(e);
+        }
+    }
+}
