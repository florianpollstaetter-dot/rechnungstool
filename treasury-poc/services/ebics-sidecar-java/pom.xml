<?xml version="1.0" encoding="UTF-8"?>
<!--
  ebics-java-client sidecar (Kandidat A).
  PoC-Scope: Spring Boot 3.x + ebics-java-client 2.0.0 via JitPack.
  Library-Lizenz: LGPL-2.1-or-later (dynamic linking → unsere App bleibt proprietär).
  Build: ./mvnw clean package; Run: java -jar target/ebics-sidecar-java-0.1.0.jar
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.orangeocto</groupId>
    <artifactId>ebics-sidecar-java</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <properties>
        <java.version>17</java.version>
        <ebics.version>2.0.0</ebics.version>
    </properties>

    <repositories>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
          ebics-java-client (Kandidat A).
          Released artifact via JitPack — coordinates pinned for reproducibility.
          Upstream: https://github.com/ebics-java/ebics-java-client
        -->
        <dependency>
            <groupId>com.github.ebics-java</groupId>
            <artifactId>ebics-java-client</artifactId>
            <version>${ebics.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
